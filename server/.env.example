APP_PORT=3000
APP_TIMEZONE=-03:00
NODE_ENV=development

# TiDB Cloud (trusted zone). Never commit real credentials.
# Local convention: port 4000 + TLS.
DB_HOST=gateway.example.tidbcloud.com
DB_PORT=4000
DB_USERNAME=app_user
DB_PASSWORD=replace-me
DB_DATABASE=openlegalai
DB_SSL=true

# Local-only persistent chat demo. Never enable this as production authorization.
CHAT_DEMO_ENABLED=false
CHAT_DEMO_SENDER_NAME=Usuário demonstrativo
CHAT_DEMO_SENDER_ROLE=Equipe jurídica
# Optional PEM path if the cluster needs a custom CA.
# DB_SSL_CA=/path/to/isrgrootx1.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Trilha de auditoria append-only do gateway.
GATEWAY_AUDIT_FILE=audit/auditoria.jsonl

# ProcessSource: fixture | datajud | eproc | manual | upload
# Only fixture is implemented in v0; others fail closed until adapters land.
PROCESS_SOURCE=fixture

# WhatsApp send-tool skeleton (not inbox). Leave empty for local stub connect.
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_REDIRECT_URI=http://127.0.0.1:3000/api/whatsapp/oauth/callback
