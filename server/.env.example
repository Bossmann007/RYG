APP_PORT=3000
APP_TIMEZONE=-03:00
NODE_ENV=development

# TiDB Cloud (trusted zone). Never commit real credentials.
# Local convention: port 4000 + TLS.
DB_HOST=gateway.example.tidbcloud.com
DB_PORT=4000
DB_USERNAME=app_user
DB_PASSWORD=replace-me
DB_DATABASE=openlegalai
DB_SSL=true

# Local-only persistent chat demo. Never enable this as production authorization.
CHAT_DEMO_ENABLED=false
CHAT_DEMO_SENDER_NAME=Usuário demonstrativo
CHAT_DEMO_SENDER_ROLE=Equipe jurídica
# Optional PEM path if the cluster needs a custom CA.
# DB_SSL_CA=/path/to/isrgrootx1.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Trilha de auditoria append-only do gateway.
GATEWAY_AUDIT_FILE=audit/auditoria.jsonl

# Bearer idle. After this gap the same token is 401. Default in code is 30 minutes.
HUB_IDLE_TIMEOUT_MS=1800000
# Test clock for the idle proof. Ignored when NODE_ENV=production.
# HUB_NOW_MS=

# Vault envelope passphrase. Empty fails closed (503, nothing stored).
HUB_VAULT_KEY=

# Office ids that may use office-hosted consult, comma-separated. Empty leaves it off.
OFFICE_HOSTED_AI=
# PA opt-in. Both lists must include the caller. Empty leaves PA off. Consult flag does not grant PA.
OFFICE_PA=
PA_USERS=
# Optional local chat model for that consult. Empty returns the cited snippets.
# OLLAMA_CONSULT_MODEL=

# ProcessSource: fixture | datajud | eproc | manual | upload
# PROCESS_SOURCE=manual is the in-memory adapter (restart wipes capas).
# datajud / eproc / upload stay unconfigured until adapters land.
PROCESS_SOURCE=fixture

# WhatsApp send-tool skeleton (not inbox). Leave empty for local stub connect.
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_REDIRECT_URI=http://127.0.0.1:3000/api/whatsapp/oauth/callback
