APP_PORT=3000
APP_TIMEZONE=-03:00
NODE_ENV=development

# Hub truth store. Protocol is MySQL wire via mysql2 (MySQL 8, MariaDB, or TiDB).
# Never commit real credentials. App DB name must not be sys/mysql.
#
# Local MariaDB/MySQL example (no TLS):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SSL=false
#
# TiDB Cloud example (TLS on 4000):
DB_HOST=gateway.example.tidbcloud.com
DB_PORT=4000
DB_USERNAME=app_user
DB_PASSWORD=replace-me
DB_DATABASE=HubLegal
DB_SSL=true

# Legacy local chat flags. Per-case chat and workspace DMs require Bearer identity.
# CHAT_DEMO_ENABLED no longer authorizes unauthenticated /api/processos/:id/chat.
CHAT_DEMO_ENABLED=false
CHAT_DEMO_SENDER_NAME=Usuário demonstrativo
CHAT_DEMO_SENDER_ROLE=Equipe jurídica
# Optional PEM path if the cluster needs a custom CA.
# DB_SSL_CA=/path/to/isrgrootx1.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Trilha de auditoria append-only do gateway.
GATEWAY_AUDIT_FILE=audit/auditoria.jsonl

# Hub session idle (ms). Default in code is 30 minutes.
# HUB_IDLE_TIMEOUT_MS=1800000
# HUB_NOW_MS is only honored outside production (prova clock advance).

# Passphrase for the in-memory secrets vault (AES-256-GCM). Empty in git.
HUB_VAULT_KEY=


# ProcessSource: fixture | datajud | eproc | manual | upload
# Only fixture is implemented in v0; others fail closed until adapters land.
PROCESS_SOURCE=fixture

# WhatsApp send-tool skeleton (not inbox). Leave empty for local stub connect.
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_REDIRECT_URI=http://127.0.0.1:3000/api/whatsapp/oauth/callback
